{
  "swagger": "2.0",
  "info": {
    "title": "Paws & Homes Foundation API",
    "description": "This is the API documentation for the Paws & Homes Foundation. It provides information about the available endpoints, request parameters, and response formats.",
    "version": "1.0.0"
  },
  "host": "rescue-animals-api.onrender.com",
  "basePath": "/",
  "schemes": [
    "https",
    "http"
  ],
  "paths": {
    "/animals/": {
      "get": {
        "tags": [
          "Animals"
        ],
        "description": "Endpoint to retrieve all animals from the database.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Animals"
        ],
        "description": "Endpoint to create a new animal in the database.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "New Animal details",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Firulais"
                },
                "species": {
                  "type": "string",
                  "example": "Dog"
                },
                "breed": {
                  "type": "string",
                  "example": "Beagle"
                },
                "age": {
                  "type": "number",
                  "example": 2
                },
                "gender": {
                  "type": "string",
                  "example": "Male"
                },
                "healthStatus": {
                  "type": "string",
                  "example": "Healthy"
                },
                "status": {
                  "type": "string",
                  "example": "available"
                }
              },
              "required": [
                "name",
                "species",
                "breed",
                "age",
                "gender",
                "healthStatus"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/animals/{id}": {
      "get": {
        "tags": [
          "Animals"
        ],
        "description": "Endpoint to retrieve an animal by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Animals"
        ],
        "description": "Endpoint to update an animal in the database.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Animal data to update",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Firulais"
                },
                "species": {
                  "type": "string",
                  "example": "Dog"
                },
                "breed": {
                  "type": "string",
                  "example": "Beagle"
                },
                "age": {
                  "type": "number",
                  "example": 3
                },
                "gender": {
                  "type": "string",
                  "example": "Male"
                },
                "healthStatus": {
                  "type": "string",
                  "example": "Healthy"
                },
                "status": {
                  "type": "string",
                  "example": "adopted"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Animals"
        ],
        "description": "Endpoint to delete an animal from the database.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/users/": {
      "get": {
        "tags": [
